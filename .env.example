# Maximum file size in megabytes
MAX_FILE_SIZE_MB=10

# Temporary directory for uploaded and processed files
TEMP_DIR=./temp

# Number of pages to extract text from for preview
PDF_PREVIEW_PAGES=3

# Timeout for temporary files in seconds (5 minutes)
TEMP_FILE_TIMEOUT=300

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/pdf_assist

# NextAuth configuration
NEXTAUTH_SECRET=your_random_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Google Gemini API Key for statement analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Encryption key for password storage (must be 32 characters)
ENCRYPTION_KEY=your_32_character_encryption_key
