# Maximum file size in megabytes
MAX_FILE_SIZE_MB=10

# Temporary directory for uploaded and processed files
TEMP_DIR=./temp

# Number of pages to extract text from for preview
PDF_PREVIEW_PAGES=3

# Timeout for temporary files in seconds (5 minutes)
TEMP_FILE_TIMEOUT=300

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/pdf_assist

# NextAuth configuration
NEXTAUTH_SECRET=your_random_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Gemini API Key (Required if LLM_PROVIDER=gemini)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# LLM Provider Configuration
LLM_PROVIDER="gemini" # or "openai"
OPENAI_API_KEY="your-openai-api-key-here"

# Optional: Langfuse Tracing
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"

# Encryption key for password storage (must be 32 characters)
ENCRYPTION_KEY=your_32_character_encryption_key
